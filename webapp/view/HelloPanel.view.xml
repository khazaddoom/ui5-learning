<mvc:View
    controllerName="ui5.walkthrough.controller.HelloPanel"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
<Panel headerText="Welcome Page" class="sapUiResponsiveMargin"
							width="auto">
                        <content>
                            <Text text="Welcome {/recipient/name}" class="sapUiSmallMarginEnd myCustomText" />
                            <Button
                                text="{i18n>showHelloButtonText}"
                                press=".onShowHello"
                                class="sapUiSmallMargin btn"
                                icon="sap-icon://paper-plane"
                            />
                            <Button 
                                text="Show Dialog"
                                press=".openDialog"
                                class="sapUiSmallMargin btn"
                                icon="sap-icon://world"
                            ></Button>
                        </content>
                    </Panel>
<Panel headerText="Employee Section" class="sapUiResponsiveMargin"
							width="auto">
                            <content>
                                <core:Fragment
      fragmentName="ui5.walkthrough.view.EmployeeCard"
      type="XML"/>
                            </content>
</Panel>
</mvc:View>