<mvc:View
    controllerName="ui5.walkthrough.controller.App"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
>
    <App>
        <pages>
            <Page title="Welcome to UI5 learning">
                <content>
                    <Panel headerText="Welcome Page">
                        <content>
                            <Text text="Welcome {/recipient/name}" />
                            <Button
                                text="{i18n>showHelloButtonText}"
                                press=".onShowHello"
                            />
                        </content>
                    </Panel>
                </content>
            </Page>
        </pages>
    </App>
</mvc:View>
