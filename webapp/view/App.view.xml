<mvc:View
    controllerName="ui5.walkthrough.controller.App"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
>
<Shell>
    <App class="myApplication">
        <pages>
            <Page title="Welcome to UI5 learning">
                <content>
                    <Panel headerText="Welcome Page" class="sapUiResponsiveMargin"
							width="auto">
                        <content>
                            <Text text="Welcome {/recipient/name}" class="sapUiSmallMarginEnd myCustomText" />
                            <Button
                                text="{i18n>showHelloButtonText}"
                                press=".onShowHello"
                                class="sapUiSmallMargin btn"
                            />
                        </content>
                    </Panel>
                </content>
            </Page>
        </pages>
    </App>
</Shell>
</mvc:View>
